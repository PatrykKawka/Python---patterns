# ============================================================
# N-gramy w tekście: najczęstsze frazy w tytułach transakcji
# Pytanie: "Jakie słowa i kombinacje słów najczęściej występują w tych danych?"
# ============================================================
from sklearn.feature_extraction.text import CountVectorizer

vectorizer = CountVectorizer(
    ngram_range=(2, 12),  # opcjonalny (domyślnie (1, 1)); (min_n, max_n) = długość frazy w słowach, (2, 12) => frazy od 2 do 12 kolejnych słów, BEZ pojedynczych słów
    min_df=10,            # opcjonalny (domyślnie 1); min. liczba wierszy (dokumentów), w których fraza musi wystąpić, by trafić do słownika
)

X = vectorizer.fit_transform(autowyplaty["TYTUL_TRANSAKCJI_CLEAN"]) # Wynik: rzadka macierz (scipy.sparse) o kształcie (liczba_tytułów, liczba_fraz)

# Suma po wierszach (axis=0) => łączna liczba wystąpień każdej frazy w całym zbiorze. Wynik to np.matrix 1×N, a .A1 spłaszcza go do zwykłej tablicy 1D (ndarray)
freq = X.sum(axis=0).A1

ngrams = pd.DataFrame({
    "fraza": vectorizer.get_feature_names_out(),  # nazwy kolumn macierzy (kolejność = kolejność w X)
    "liczba": freq,
}).sort_values("liczba", ascending=False)

